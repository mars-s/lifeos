{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifeos-read-mirror",
  "account_id": "d0f2ba4b10b5789ddd200648bbf055a7",
  "main": "mcp-entry.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{"type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true}],
  // Redacted: the code logs only fixed sign-in facts, never URLs, cookies, tokens or codes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {"enabled": true, "invocation_logs": false}
  },
  "vars": {
    "LIFEOS_OWNER_ID": "avi-lifeos-owner",
    "LIFEOS_ADAPTER_ID": "avi-mac-things-readonly",
    "LIFEOS_GITHUB_OWNER_ID": "71009876",
    "LIFEOS_WRITES_ENABLED": "true",
    "LIFEOS_CLOUD_WINS_ENABLED": "true",
    "LIFEOS_SMART_SYNC_ENABLED": "true"
  },
  "durable_objects": {"bindings": [{"name": "OWNER_SYNC", "class_name": "OwnerSync"}]},
  // Read-only Oura access. A named entrypoint has no public URL; see integrations/oura-setup/health-reader.mjs.
  "services": [{"binding": "OURA_HEALTH", "service": "lifeos-app-setup", "entrypoint": "HealthReader"}],
  "migrations": [{"tag": "owner-sync-v1", "new_sqlite_classes": ["OwnerSync"]}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeos-read-mirror",
      "database_id": "980cb359-5819-4deb-b2c7-c57c446ba6dc",
      "migrations_dir": "../site/drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "104729ae5c99424fb6d293062e0856a3"
    }
  ]
}
